# ---------------------------------------------------------------------------
# Apply Now — email channel configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed. This example file is
# the only env file in the repository, and it contains placeholders only.
#
# For the live site, paste the same six keys into:
#   Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# SMTP server hostname, e.g. smtp.gmail.com
SMTP_HOST=

# 587 for STARTTLS (typical) or 465 for implicit TLS
SMTP_PORT=587

# SMTP account username
SMTP_USER=

# SMTP account password or app-specific password
SMTP_PASS=

# The From header on outgoing mail, e.g. "Taoohan Careers <noreply@example.com>"
SMTP_FROM=

# The business inbox that receives job applications
APPLY_TO_EMAIL=
