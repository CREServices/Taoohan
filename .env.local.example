# ---------------------------------------------------------------------------
# Employer hiring requests — SMTP configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed. This example file is
# the only env file in the repository, and it contains placeholders only.
#
# For the live site, paste the same keys into:
#   Vercel → Project → Settings → Environment Variables
#
# NOTE: the job-seeker "I'm Looking for Work" form no longer sends email at
# all — it hands off to WhatsApp (CONTACT.whatsapp in src/config/contact.ts,
# already confirmed). Only the employer "I'm Hiring Staff" form needs SMTP.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Job-seeker CV uploads — Vercel Blob storage
# ---------------------------------------------------------------------------
# The job-seeker form is WhatsApp only, but a wa.me link cannot carry a file
# attachment. So the CV is uploaded to Blob storage and the pre-filled
# WhatsApp message carries a download link to it.
#
# REQUIRED IN PRODUCTION. Vercel's filesystem is ephemeral, so without this
# token an uploaded CV is gone before the recruiter can open the link.
#
#   Vercel → Project → Storage → Create a Blob store
#   (Vercel injects BLOB_READ_WRITE_TOKEN into the project automatically)
#
# Leave blank locally: `next dev` falls back to writing under .cv-uploads/
# and serving the file back via /api/cv/[id], so the flow is testable
# end to end without a blob store.
BLOB_READ_WRITE_TOKEN=

# SMTP server hostname, e.g. smtp.gmail.com
SMTP_HOST=

# 587 for STARTTLS (typical) or 465 for implicit TLS
SMTP_PORT=587

# SMTP account username
SMTP_USER=

# SMTP account password or app-specific password
SMTP_PASS=

# The From header on outgoing mail, e.g. "Taoohan Hiring <noreply@example.com>"
SMTP_FROM=

# Optional — the recipient defaults to the already-confirmed CONTACT.email
# (info@cresvcs.com, in src/config/contact.ts) if these are left blank. Set
# either one only if the client wants employer requests routed to a
# different inbox than the confirmed business address.
APPLY_TO_EMAIL=
REQUEST_TO_EMAIL=
