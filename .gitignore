# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Allow the example env file to be committed
!.env.local.example

# playwright + gate loop artifacts
/test-results/
/playwright-report/
/blob-report/
.claude/gate-state.json

# raw source media — original uncompressed uploads, never shipped or committed.
# The compressed/served versions live under public/.
/raw-assets/

# internal planning, briefs and working notes — kept local, never pushed.
# Covers the milestone brief, the build guide, the agent instruction files
# and everything under docs/. These stay on disk; they are simply untracked.
*.md
/docs/

# internal planning docs and client materials (coaching scripts, milestone
# decks, content/copy briefs) — not application source, never pushed.
*.pdf
/milestone2-deck/

# local tool state (beads database/lock files) — not source, never pushed.
/.beads/

# oversized source video (317MB) — exceeds GitHub's 100MB file limit.
# Stays on disk; not referenced by any component, so nothing breaks by
# leaving it untracked. Re-add via Git LFS if it needs to ship.
/public/video/manpower.mp4
