# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/
/playwright.config.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Allow the example env file to be committed
!.env.local.example

# playwright + gate loop artifacts
/test-results/
/playwright-report/
/blob-report/
.claude/gate-state.json

# Documents & Planning Files (non-source)
*.pdf
*.doc
*.docx
*.rtf
*.odt
*.ppt
*.pptx
*.xls
*.xlsx

# AI/Internal Workflow Files
.claude/
.qodo/
.beads/
CLAUDE.md
RULES.md
LOOP.md
loop-*.md
STATE.md

# Planning & Asset Folders
milestone2-deck/
raw-assets/

# Transcription & Internal Scripts
*transcript*
*coaching-script*

# raw source media — original uncompressed uploads, never shipped or committed.
# The compressed/served versions live under public/.
/raw-assets/

# internal planning, briefs and working notes — kept local, never pushed.
# Covers the milestone brief, the build guide, the agent instruction files
# and everything under docs/. These stay on disk; they are simply untracked.
*.md
/docs/

# internal planning docs and client materials (coaching scripts, milestone
# decks, content/copy briefs) — not application source, never pushed.
*.pdf
/milestone2-deck/

# local tool state (beads database/lock files) — not source, never pushed.
/.beads/

# Oversized raw video masters dropped in public/video/ for re-encoding —
# exceed GitHub's 100MB file limit. Only the encoded hero-1080/540 outputs
# below this path are ever referenced by a component and tracked; a raw
# master gets copied to raw-assets/ (also gitignored) and deleted from here
# once it's been re-encoded. This blanket pattern is deliberately broader
# than one filename so a future drop is never accidentally staged.
/public/video/manpower.mp4
/public/video/0901.mp4
/public/video/[0-9]*.mp4

# push tooling - internal workflow, never shipped
/fresh-push.sh
